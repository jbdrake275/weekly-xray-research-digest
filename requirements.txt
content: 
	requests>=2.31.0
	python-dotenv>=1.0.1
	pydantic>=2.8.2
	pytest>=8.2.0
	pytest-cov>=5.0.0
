name: Weekly X-Ray Research Digest

on:
  schedule:
    - cron: '0 12 * * 1'
  workflow_dispatch:

jobs:
  digest:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Generate digest
        env:
          OPENALEX_EMAIL: ${{ secrets.OPENALEX_EMAIL }}
          GITHUB_MODELS_TOKEN: ${{ secrets.GITHUB_MODELS_TOKEN }}
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          AZURE_OPENAI_ENDPOINT: ${{ secrets.AZURE_OPENAI_ENDPOINT }}
          AZURE_OPENAI_KEY: ${{ secrets.AZURE_OPENAI_KEY }}
        run: |
          python -m src.main --output-dir reports --publish-report

      - name: Upload logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: weekly-digest-logs
          path: |
            logs/
            reports/
          if-no-files-found: warn

      - name: Commit generated files
        if: success()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data reports
          git diff --cached --quiet || git commit -m "Update weekly digest report"
          git push

      - name: Create GitHub release
        if: success()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          REPORT_PATH=$(find reports -type f -name '*.md' | sort | tail -n 1)
          VERSION=$(date +'%Y-%m-%d')
          gh release create "weekly-digest-${VERSION}" "$REPORT_PATH" --title "Weekly X-Ray Research Digest ${VERSION}" --notes "Automated weekly digest of X-ray research literature."
